	hierarchy Data
		lineageTag: 7ae4d158-850b-4290-9ac2-11dea2e9c590

		level Year-Month
			lineageTag: c9c2835b-3b21-44b6-8036-09ef5afa09e1
			column: Year-Month

		level Quarter
			lineageTag: 60225cd2-1a0d-4dc2-9f40-caa6aaafbab9
			column: Quarter

		level 'Month Number'
			lineageTag: ffacb11b-f61a-4a75-b1d8-17e98cfc09df
			column: 'Month Number'

		level Day
			lineageTag: 20458b47-af2f-477e-b365-81e33627dd4d
			column: Day

	partition DateTable_FromFactTable = calculated
		mode: import
		source =
				
				VAR StartDate = MIN (F_sales[Date])
				VAR EndDate   = MAX (F_sales[Date])
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( StartDate, EndDate ),
				    "Year", YEAR ( [Date] ),
				    "Month Number", MONTH ( [Date] ),
				    "Month Name LT",
				        SWITCH (
				            MONTH ( [Date] ),
				            1, "January",
				            2, "February",
				            3, "March",
				            4, "April",
				            5, "May",
				            6, "June",
				            7, "July",
				            8, "August",
				            9, "September",
				            10, "October",
				            11, "November",
				            12, "December"
				        ),
				    "Year-Month", FORMAT ( [Date], "YYYY-MM" ),
				    "Quarter", "Q" & FORMAT ( [Date], "Q" ),
				    "Day", DAY ( [Date] ),
				    "Week Number", WEEKNUM ( [Date], 2 ),
				    "Weekday Number", WEEKDAY ( [Date], 2 ),
				    "Weekday Name LT",
				        SWITCH (
				            WEEKDAY ( [Date], 2 ),
				            1, "Monday",
				            2, "Tuesday",
				            3, "Wednesday",
				            4, "Thursday",
				            5, "Friday",
				            6, "Saturday",
				            7, "Sunday"
				        ),
				    "Last 30 Days",
				        IF ( [Date] >= TODAY() - 29 && [Date] <= TODAY(), "Yes", "No" ),
				    "Last 12 Months",
				        IF ( [Date] >= EDATE ( TODAY(), -12 ) + 1 && [Date] <= TODAY(), "Yes", "No" )
				)

	annotation PBI_Id = d37703a02f1f4259ae675b364860af4b

